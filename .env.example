# ==========================================
# Configuración de la Cámara MIPC
# ==========================================
CAM_IP=10.10.10.110
CAM_USER=tu_usuario
CAM_PASS=tu_password
CAM_PORT=7010

# ==========================================
# Servicios y Canales Habilitados
# ==========================================
ENABLE_WEB=true
ENABLE_RTSP=true
ENABLE_VNC=false

# ==========================================
# Resolución y Zona Horaria
# ==========================================
RES_MAIN=1920x1080
TIMEZONE_OFFSET=-6

# ==========================================
# Grabación Continua de Video
# ==========================================
# Habilita o deshabilita la grabación continua de video (.ts)
GRABAR_VIDEO=false

# Días de retención para eliminar grabaciones antiguas de /app/grabaciones
DIAS_RETENCION=7

# Duración de cada segmento de video en minutos
MINUTOS_SEGMENTO=15

# ==========================================
# Servidor HTTP MJPEG (Puerto 8080 - Tablets Legacy / Android)
# Valores recomendados para Raspberry Pi 4 (Balance perfecto entre CPU y fluidez)
# ==========================================
# MJPEG_RES: Resolución de salida para la señal MJPEG (ej: 640x360, 480x270, 1280x720)
MJPEG_RES=640x360

# MJPEG_FPS: Fotogramas por segundo del servidor MJPEG (ej: 10, 15)
MJPEG_FPS=10

# MJPEG_QUALITY: Calidad de compresión JPEG (Rango: 2 a 31. Menor número = Mayor calidad y peso; Mayor número = Mayor compresión)
MJPEG_QUALITY=8

# MJPEG_UPDATE_INTERVAL: Tiempo de espera en segundos entre ciclos de envío de tramas por cliente (ej: 0.05 = 50ms)
MJPEG_UPDATE_INTERVAL=0.05

# ⚠️ ADVERTENCIA DE RENDIMIENTO:
# Aumentar la resolución (ej: a 1920x1080), subir los FPS (ej: a 30) o reducir el número de compresión MJPEG_QUALITY
# incrementará considerablemente el uso de CPU de la Raspberry Pi 4 y el ancho de banda por cada tablet conectada.

# ==========================================
# Configuración de Logs y Rotación
# ==========================================
# LOG_MAX_SIZE_MB: Tamaño máximo por archivo de log en MB antes de rotar (defecto: 5)
LOG_MAX_SIZE_MB=5

# LOG_BACKUP_COUNT: Cantidad de archivos de log rotados a mantener (defecto: 3)
LOG_BACKUP_COUNT=3

# LOG_RETENTION_DAYS: Días de retención para eliminar logs rotados antiguos (defecto: 7)
LOG_RETENTION_DAYS=7

# Nivel de log para los subprocesos de FFmpeg (quiet, panic, fatal, error, warning, info, verbose, debug)
FFMPEG_LOGLEVEL=error
FFMPEG_MJPEG_LOGLEVEL=error
# FFMPEG_RW_TIMEOUT=5000000
