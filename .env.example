# ==========================================
# Configuración de la Cámara MIPC
# ==========================================
CAM_IP=10.10.10.110
CAM_USER=tu_usuario
CAM_PASS=tu_password
CAM_PORT=7010

# ==========================================
# Servicios y Canales Habilitados
# ==========================================
ENABLE_WEB=true
ENABLE_RTSP=true
ENABLE_VNC=false

# ==========================================
# Resolución y Zona Horaria
# ==========================================
RES_MAIN=1920x1080
TIMEZONE_OFFSET=-6

# ==========================================
# Grabación Continua de Video
# ==========================================
# Habilita o deshabilita la grabación continua de video (.ts)
GRABAR_VIDEO=false

# Días de retención para eliminar grabaciones antiguas de /app/grabaciones
DIAS_RETENCION=7

# Duración de cada segmento de video en minutos
MINUTOS_SEGMENTO=15

# ==========================================
# Servidor HTTP MJPEG (Puerto 8080 - Tablets Legacy / TinyCam Pro)
# Valores recomendados para Raspberry Pi 4 (Consumo ultra bajo: ~5% CPU total)
# ==========================================
# MJPEG_RES: Resolución de salida (ej: 640x360, 1024x576, o 'native')
MJPEG_RES=640x360

# MJPEG_FPS: Fotogramas por segundo (Recomendado: 2 a 5 para consumo mínimo de CPU)
MJPEG_FPS=2

# MJPEG_QUALITY: Calidad de compresión JPEG (Rango: 2-31; 8 a 12 = balance óptimo de calidad, memoria y CPU)
MJPEG_QUALITY=8

# MJPEG_UPDATE_INTERVAL: Intervalo de envío de tramas por cliente en segundos (ej: 0.1s = 10 FPS max envío)
MJPEG_UPDATE_INTERVAL=0.1

# ⚠️ ADVERTENCIA DE RENDIMIENTO Y USO DE CPU:
# - Aumentar la resolución a 'native' (1080p) o subir FPS procesa millones de píxeles por segundo por software,
#   lo que puede incrementar el uso de CPU de 1 núcleo del 20% hasta el 150%.
# - Ajustar MJPEG_QUALITY a valores menores como 2 incrementa el peso de cada foto a 250KB+, saturando RAM e I/O.
# - El servidor apaga automáticamente FFmpeg a 0.0% CPU tras 5 segundos sin clientes activos.

# ==========================================
# Configuración de Logs y Rotación
# ==========================================
# LOG_MAX_SIZE_MB: Tamaño máximo por archivo de log en MB antes de rotar (defecto: 5)
LOG_MAX_SIZE_MB=5

# LOG_BACKUP_COUNT: Cantidad de archivos de log rotados a mantener (defecto: 3)
LOG_BACKUP_COUNT=3

# LOG_RETENTION_DAYS: Días de retención para eliminar logs rotados antiguos (defecto: 7)
LOG_RETENTION_DAYS=7

# Nivel de log para los subprocesos de FFmpeg (quiet, panic, fatal, error, warning, info, verbose, debug)
FFMPEG_LOGLEVEL=error
FFMPEG_MJPEG_LOGLEVEL=error
# FFMPEG_RW_TIMEOUT=5000000
