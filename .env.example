# ==========================================
# Configuración de la Cámara MIPC
# ==========================================
CAM_IP=10.10.10.110
CAM_USER=tu_usuario
CAM_PASS=tu_password
CAM_PORT=7010

# ==========================================
# Servicios y Canales Habilitados
# ==========================================
ENABLE_WEB=true
ENABLE_RTSP=true
ENABLE_VNC=false

# ==========================================
# Resolución y Zona Horaria
# ==========================================
RES_MAIN=1920x1080
TIMEZONE_OFFSET=-6

# ==========================================
# Grabación Continua de Video
# ==========================================
# Habilita o deshabilita la grabación continua de video (.ts)
GRABAR_VIDEO=false

# Días de retención para eliminar grabaciones antiguas de /app/grabaciones
DIAS_RETENCION=7

# Duración de cada segmento de video en minutos
MINUTOS_SEGMENTO=15

# ==========================================
# Configuración de Logs y Rotación
# ==========================================
# LOG_MAX_SIZE_MB: Tamaño máximo por archivo de log en MB antes de rotar (defecto: 5)
LOG_MAX_SIZE_MB=5

# LOG_BACKUP_COUNT: Cantidad de archivos de log rotados a mantener (defecto: 3)
LOG_BACKUP_COUNT=3

# LOG_RETENTION_DAYS: Días de retención para eliminar logs rotados antiguos (defecto: 7)
LOG_RETENTION_DAYS=7

# Nivel de log para los subprocesos de FFmpeg (quiet, panic, fatal, error, warning, info, verbose, debug)
FFMPEG_LOGLEVEL=error
FFMPEG_MJPEG_LOGLEVEL=error
# FFMPEG_RW_TIMEOUT=5000000
